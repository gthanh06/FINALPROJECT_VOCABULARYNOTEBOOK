# .env.example — copy to .env and fill in. .env is ignored by Git: never commit real keys.
#   cp .env.example .env

# PostgreSQL. With `docker compose up` this is set by compose.yaml and can stay empty here.
# Supabase: Project Settings → Database → Connection string (Transaction pooler, port 6543).
DATABASE_URL=

# Admin account created / reset at start-up (python -m app.migrate). Password: 8+ characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- AI (Google Gemini) ----------
# Free key: https://aistudio.google.com/apikey  — the key stays on the server, the browser never sees it.
# Without a key the app works as before and the AI buttons are disabled.
GEMINI_API_KEY=
# Model name, changeable without touching the code. Free tier: gemini-3.5-flash-lite, gemini-3.8-flash.
GEMINI_MODEL=gemini-3.5-flash-lite
# Seconds to wait for one Gemini answer before giving up.
GEMINI_TIMEOUT=20

# AI requests allowed per user (looking up a word that is already cached does not count).
AI_LIMIT_PER_MINUTE=5
AI_LIMIT_PER_DAY=50
