# .dockerignore — keep the build context small and secrets out of the image.
.git
.github
.gitignore
.env
.env.*
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.DS_Store
tests/
scripts/
data/
requirements-dev.txt
Dockerfile
.dockerignore
compose.yaml
render.yaml
*.md
# ...except the prompts sent to the AI, which the app reads at run time.
!prompts/*.md
